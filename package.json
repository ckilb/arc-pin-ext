{
  "name": "tab-pin-ext",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Turn a bookmark folder into pinned tabs and tab groups in one browser window.",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.mjs",
    "package": "node tools/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "VITEST_SKIP_INSTALL_CHECKS=1 vitest run --coverage",
    "test:e2e": "node tools/build.mjs && node test/e2e/run.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "happy-dom": "^20.14.6",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.9",
    "rolldown": "^1.2.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
